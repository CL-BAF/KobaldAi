{
  "schema_version": 1,
  "experiment_id": "damped-oscillator-dop853",
  "question": "Does SciPy's adaptive DOP853 integrator reproduce the closed-form motion of an under-damped mass-spring-damper (zeta ~= 0.05) over about ten natural periods to within 1e-7 relative tolerance, deterministically and with errors that shrink when integrator tolerances are tightened?",
  "engine": "scipy",
  "task": "damped_harmonic_oscillator",
  "parameters": {
    "mass": {"value": 250.0, "unit": "g"},
    "stiffness": {"value": 40.0, "unit": "N/m"},
    "damping": {"value": 0.316227766, "unit": "kg/s"},
    "initial_displacement": {"value": 5.0, "unit": "cm"},
    "initial_velocity": {"value": 0.0, "unit": "m/s"},
    "duration": {"value": 5.0, "unit": "s"}
  },
  "options": {"method": "DOP853", "rtol": 1e-10, "atol": 1e-12, "n_samples": 2001},
  "seed": 0,
  "budget": {"wall_time_s": 60.0, "memory_mb": 1024, "max_output_bytes": 20000000},
  "tolerance": {"rtol": 1e-7, "atol": 1e-10}
}
